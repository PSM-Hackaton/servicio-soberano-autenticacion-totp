#!/bin/sh
# Gancho commit-msg del equipo (se instala con: sh scripts/instalar-hooks.sh).
# Exige mensajes en castellano, con título de 10 a 100 caracteres (recomendado hasta 72), sin líneas de
# coautoría ni menciones a herramientas de generación. Recomienda «tipo(ámbito): descripción» y «#issue».
DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
command -v node >/dev/null 2>&1 || { echo 'commit-msg: se necesita Node.js 22 en el PATH' >&2; exit 1; }
exec node "$DIR/revisar.mjs" mensaje "$1"
