# Portal de Trámites del Estado (demo institucional) — copie a .env y ajuste.
# NUNCA suba el .env real al repositorio.

# Dónde escucha el portal
PORTAL_HOST=127.0.0.1
PORTAL_PUERTO=8444
# HTTPS: si existen estos archivos el portal usa TLS; si no, HTTP solo en localhost (pruebas)
PORTAL_TLS_CERT=../backend/certs/localhost.crt
PORTAL_TLS_KEY=../backend/certs/localhost.key

# Servicio Soberano TOTP (credenciales de la app integradora "Portal de Trámites").
# Copie el client_id (app_...) y el client_secret que imprime `cd backend && npm run seed`;
# el secreto se muestra una sola vez (también puede registrarse una app nueva en la consola admin).
TOTP_BASE_URL=https://localhost:8443
# Obligatorio (sin valor por defecto: el portal no arranca hasta configurarlo).
TOTP_CLIENT_ID=app_COPIAR_DEL_CLIENT_ID_QUE_IMPRIME_NPM_RUN_SEED
TOTP_CLIENT_SECRET=CAMBIAR_POR_EL_SECRETO_MOSTRADO_UNA_SOLA_VEZ
# CA local que firmó el certificado del servicio (PEM). Vacío = CAs del sistema.
TOTP_CA_PATH=../backend/certs/ca.crt
# Claims esperados en el JWT MFA (iss = JWT_ISSUER del backend; aud = client_id por defecto)
TOTP_ISSUER=https://totp.soberano.local
TOTP_AUDIENCE=
TOTP_TIMEOUT_MS=3000

# App autenticadora (PWA) para el botón "Abrir en el Autenticador Soberano"
AUTENTICADOR_URL=https://localhost:8443/app/
PORTAL_ETIQUETA_CUENTA=Portal de Trámites

# Secreto (>= 32 caracteres) del HMAC que deriva el user_ref enviado al servicio a partir de la cédula.
# Vacío = se genera al azar en datos/seudonimos.clave. Cambiarlo desvincula a todos los ciudadanos.
PORTAL_SECRETO_SEUDONIMOS=

# Panel "Lo que ocurre por dentro" visible al entrar (1/0)
PORTAL_TRAZAS=1
PORTAL_SESION_MINUTOS=15

# IP del ciudadano que el portal envía al servicio como client_ip (detector y límites por persona,
# no por portal). Por defecto: la dirección del socket. Ponga 1 SOLO si un proxy inverso propio
# está delante del portal (se usa la última entrada de X-Forwarded-For); si no, cualquiera podría falsificarla.
PORTAL_CONFIAR_X_FORWARDED_FOR=0
