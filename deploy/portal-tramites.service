# Unidad systemd del Portal de Trámites (sistema integrador de demostración) en modo sistema.
# La instala `sudo sh deploy/instalar.sh`. Escucha en HTTPS 8444 con el mismo certificado del
# servicio y llama al Servicio Soberano TOTP (8443) con las credenciales de la app "Portal de Trámites".
#   /opt/servicio-totp/demo-portal-tramites/.env -> /etc/servicio-totp/portal.env (0600 totp)
#   /var/lib/servicio-totp/portal/usuarios.json     ciudadanos ficticios (única ruta escribible)

[Unit]
Description=Portal de Trámites (integrador de demostración del Servicio Soberano TOTP)
Documentation=file:///opt/servicio-totp/deploy/README.md
After=network-online.target servicio-totp.service
Wants=network-online.target servicio-totp.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=totp
Group=totp
WorkingDirectory=/opt/servicio-totp/demo-portal-tramites
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/servicio-totp/portal
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=256
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
