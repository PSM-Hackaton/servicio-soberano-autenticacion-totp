# Unidad systemd de ejemplo para el Servicio Soberano TOTP (servidor institucional, sin contenedores).
# Instalación: ver deploy/README.md.
#   sudo cp deploy/servicio-totp.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now servicio-totp
#
# Rutas supuestas (ajústelas si cambian):
#   /opt/servicio-totp                     copia del repositorio (solo lectura para el servicio)
#   /etc/servicio-totp/servicio-totp.env   configuración y secretos (propietario root, grupo totp, 0640)
#   /etc/servicio-totp/tls/                certificado y llave institucionales (llave 0640 root:totp)
#   /var/lib/servicio-totp                 base de datos SQLite (única ruta escribible)

[Unit]
Description=Servicio Soberano de Autenticación TOTP
Documentation=file:///opt/servicio-totp/deploy/README.md
After=network-online.target chronyd.service chrony.service time-sync.target
Wants=network-online.target time-sync.target
# Máximo 10 reinicios cada 5 minutos; después systemd deja de reintentar y hay que revisar el diario.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=totp
Group=totp
WorkingDirectory=/opt/servicio-totp/backend
Environment=NODE_ENV=production
Environment=ENV_FILE=/etc/servicio-totp/servicio-totp.env
ExecStart=/usr/bin/node src/main.js

# Reinicio automático ante fallos; el servicio cierra conexiones y la base en SIGTERM (máx. 10 s).
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

# Directorio de datos gestionado por systemd (/var/lib/servicio-totp, propietario totp, 0700).
StateDirectory=servicio-totp
StateDirectoryMode=0700
UMask=0077

# Endurecimiento
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/servicio-totp
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
# Si se publica directamente en el puerto 443 en lugar de 8443, descomente:
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#AmbientCapabilities=CAP_NET_BIND_SERVICE
# MemoryDenyWriteExecute no se activa: el compilador JIT de V8 necesita memoria ejecutable.

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
