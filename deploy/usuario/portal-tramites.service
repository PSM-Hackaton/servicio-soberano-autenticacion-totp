# Unidad systemd DE USUARIO del Portal de Trámites (integrador de demostración), HTTPS 8444.
# Plantilla: deploy/instalar.sh sustituye @NODE@ y @PREFIJO@. La configuración se lee de
# @PREFIJO@/demo-portal-tramites/.env, enlace al portal.env (0600) de la carpeta de configuración.

[Unit]
Description=Portal de Trámites (integrador de demostración, modo usuario)
Documentation=file://@PREFIJO@/deploy/README.md
After=network-online.target servicio-totp.service
Wants=servicio-totp.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@PREFIJO@/demo-portal-tramites
Environment=NODE_ENV=production
ExecStart=@NODE@ server.js
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15
UMask=0077

NoNewPrivileges=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
MemoryMax=512M
TasksMax=256
LimitNOFILE=65536

[Install]
WantedBy=default.target
