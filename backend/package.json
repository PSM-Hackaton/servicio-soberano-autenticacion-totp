{
  "name": "servicio-soberano-autenticacion-totp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API del servicio soberano TOTP. Sin dependencias externas: solo módulos nativos de Node.js.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "env": "node scripts/generar-env.js",
    "certs": "node scripts/certificados.js",
    "seed": "node scripts/semilla.js",
    "test": "node --test --test-reporter=spec \"src/**/*.test.js\""
  }
}
