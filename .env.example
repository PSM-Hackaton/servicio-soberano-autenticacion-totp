# ==============================================================================
# Servicio Soberano de Autenticación Multifactorial (TOTP) — Variables de Entorno
# Copiar a .env (NUNCA subir .env real a GitHub ni GitLab)
# ==============================================================================

# Entorno y servidor HTTPS/TLS
NODE_ENV=development
HOST=0.0.0.0
PORT=8443
TLS_ENABLED=true
TLS_CERT_PATH=./certs/localhost.crt
TLS_KEY_PATH=./certs/localhost.key

# Base de datos local (SQLite WAL — sin Docker)
SQLITE_DB_PATH=./data/totp_soberano.db

# Criptografía en reposo (AES-256-GCM: 32 bytes = 64 caracteres hex)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_MASTER_KEY_HEX=CHANGE_ME_GENERATE_64_HEX_CHARS_WITH_CSPRNG

# Anonimización de direcciones IP y metadatos (HMAC-SHA256 salt local)
IP_ANON_SALT=CHANGE_ME_GENERATE_RANDOM_SALT_32_BYTES

# Identidad institucional del emisor TOTP / JWT
TOTP_ISSUER=MincytSoberanoMFA
JWT_ISSUER=https://mfa.soberano.local
JWT_AUDIENCE=institucional-api
JWT_TTL_SECONDS=300

# Credenciales semilla de administrador inicial (cambiar en primer arranque)
ADMIN_SEED_USERNAME=admin_seguridad
ADMIN_SEED_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD_12_CHARS

# Control de adaptador de IA local (local | mock)
ANOMALY_ADAPTER_MODE=local

# CORS permitido (Frontend local + equipo Reto 1)
CORS_ALLOWED_ORIGINS=https://localhost:5173,http://localhost:5173,http://localhost:3000
