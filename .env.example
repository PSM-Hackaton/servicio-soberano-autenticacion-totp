# ==============================================================================
# Servicio Soberano de Autenticación TOTP — Variables de Entorno
# Copiar a backend/.env (NUNCA subir .env real a GitHub ni GitLab)
# ==============================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=8443

# Modo TLS: caddy (detrás de Caddy TLS 1.3 en Docker) | node (HTTPS directo local sin Docker) | off (solo tests)
TLS_MODE=node
TLS_CERT_PATH=./certs/localhost.crt
TLS_KEY_PATH=./certs/localhost.key

# Persistencia oficial única (ADR-002 — node:sqlite WAL nativo de Node.js 22):
DB_DRIVER=sqlite
SQLITE_DB_PATH=./data/totp_soberano.db

# Llave maestra AES-256-GCM versionada (32 bytes = 64 hex chars generados con CSPRNG)
MASTER_KEY_VERSION=v1
MASTER_KEY_V1_HEX=CHANGE_ME_GENERATE_64_HEX_CHARS_WITH_CSPRNG

# Peppers de anonimización (HMAC-SHA256)
USER_REF_PEPPER=CHANGE_ME_RANDOM_32_BYTES_USER_PEPPER
DAILY_IP_PEPPER_SEED=CHANGE_ME_RANDOM_32_BYTES_IP_PEPPER_SEED

# Identidad institucional TOTP / JWT Ed25519
TOTP_ISSUER=MincytSoberanoTOTP
JWT_ISSUER=https://totp.soberano.local
JWT_TTL_SECONDS=300

# Sesión Consola Admin (cookies HttpOnly; Secure; SameSite=Strict)
ADMIN_SESSION_SECRET=CHANGE_ME_RANDOM_64_BYTES_SESSION_SECRET
ADMIN_SEED_USER=admin_seguridad
ADMIN_SEED_PASS=CHANGE_ME_STRONG_ADMIN_PASSWORD_12_CHARS

# Adaptador de IA Local: local (IsolationForest/scoring) | mock (desarrollo paralelo)
HEURISTICS_MODE=local

# Orígenes permitidos por CORS (PWA, Consola, Portal Trámites y Reto 1)
CORS_ALLOWED_ORIGINS=https://localhost:5173,https://localhost:5174,http://localhost:5173,http://localhost:5174,http://localhost:3000
