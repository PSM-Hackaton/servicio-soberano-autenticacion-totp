# ==============================================================================
# Servicio Soberano de Autenticación TOTP — Variables de entorno
# Solo figuran las variables que lee backend/src/infrastructure/config/config.js.
#
# Uso recomendado: `cd backend && npm run env` crea backend/.env a partir de este
# archivo, sustituye cada CHANGE_ME por un valor aleatorio fuerte (CSPRNG) y deja
# el archivo con permisos 600. Nunca sobrescribe un .env existente.
# El backend lee backend/.env, o el archivo indicado en ENV_FILE; las variables
# del proceso tienen prioridad sobre el archivo. Un valor que conserve CHANGE_ME
# impide arrancar. NUNCA subir un .env real a GitHub ni a GitLab.
# Las rutas relativas se resuelven respecto a la carpeta backend/.
# ==============================================================================

# development | production (production prohíbe TLS_MODE=off y orígenes CORS http://)
NODE_ENV=development
HOST=0.0.0.0
PORT=8443

# TLS: node (HTTPS nativo, TLS 1.3 mínimo) | off (HTTP, solo pruebas locales)
TLS_MODE=node
# Certificado y llave del servidor (obligatorios con TLS_MODE=node). En desarrollo: `npm run certs`.
TLS_CERT_PATH=./certs/localhost.crt
TLS_KEY_PATH=./certs/localhost.key
# Opcional: certificado PÚBLICO de la CA propia que se ofrece en GET /ca.crt (para instalarlo en
# teléfonos y equipos de la red). Vacío = la ruta responde 404. Nunca apunte a una llave privada.
TLS_CA_PUBLIC_PATH=

# Persistencia: solo existe el controlador sqlite (node:sqlite en modo WAL).
DB_DRIVER=sqlite
SQLITE_DB_PATH=./data/totp_soberano.db
# Confirmación a disco (PRAGMA synchronous): NORMAL (por defecto) o FULL.
#   NORMAL en WAL: sin fsync en cada transacción (×3 a ×5 verificaciones/s medidas). La base nunca se
#     corrompe ni pierde datos si se cae el proceso; un corte de energía o caída del sistema operativo
#     puede deshacer las últimas transacciones de ese instante (intentos, eventos de bitácora, pasos
#     aceptados). Use discos con protección de energía.
#   FULL: un fsync por transacción; elimina esa ventana a costa del rendimiento.
SQLITE_SYNCHRONOUS=NORMAL

# Llave maestra AES-256-GCM versionada: 32 bytes = 64 caracteres hexadecimales.
# Para rotar: añadir MASTER_KEY_V2_HEX, cambiar MASTER_KEY_VERSION=v2 y ejecutar, con el servicio
# detenido y tras una copia de seguridad, `cd backend && npm run rotar-llave-maestra`: recifra en
# una transacción las semillas y claves de firma con la versión activa (idempotente). Conservar la
# llave anterior hasta comprobarlo; después puede retirarse.
MASTER_KEY_VERSION=v1
MASTER_KEY_V1_HEX=CHANGE_ME_GENERATE_64_HEX_CHARS_WITH_CSPRNG

# Peppers de anonimización HMAC-SHA256 (mínimo 32 caracteres aleatorios cada uno).
# USER_REF_PEPPER: user_ref_hash = HMAC(user_ref, pepper). Cambiarlo invalida todos los enrolamientos.
USER_REF_PEPPER=CHANGE_ME_RANDOM_32_BYTES_USER_PEPPER
# DAILY_IP_PEPPER_SEED: semilla del pepper diario de ip_hash = HMAC(app_id:IP del usuario final, pepper del día).
DAILY_IP_PEPPER_SEED=CHANGE_ME_RANDOM_32_BYTES_IP_PEPPER_SEED

# Emisor mostrado en la app autenticadora (otpauth://) y emisor (iss) del JWT MFA.
TOTP_ISSUER=ServicioSoberanoTOTP
JWT_ISSUER=https://totp.soberano.local
# Vida del JWT MFA en segundos (30 a 3600).
JWT_TTL_SECONDS=300

# Usuario del administrador inicial que crea `npm run seed` (la contraseña se genera y se muestra una vez).
ADMIN_SEED_USER=admin_seguridad
# Opcional: dónde deja `npm run seed` el QR (SVG) del TOTP del administrador inicial.
# Vacío = admin-qr.svg junto a la base de datos (carpeta de SQLITE_DB_PATH). Bórrelo tras escanearlo.
ADMIN_QR_PATH=

# Detector de anomalías: local (Isolation Forest + reglas; bloqueo adaptativo según la política de cada app)
#   | monitorizacion (NUNCA bloquea por anomalía, en ninguna app: el detector evalúa, alerta y audita,
#     y prevalece sobre modo_heuristica=bloqueo de cada app; útil para calibrar antes de activar)
#   | mock (detector simulado con riesgo 0, para desarrollo de clientes)
HEURISTICS_MODE=local

# Límites de tasa (peticiones por minuto, token bucket en memoria; 429 con Retry-After).
# Global por IP TCP, antes de autenticar: solo anti-DDoS. Debe ser alto porque cada portal
# integrador llega con UNA sola IP (la de su servidor) para todos sus ciudadanos.
RATE_LIMIT_GLOBAL_POR_MIN=6000
# Por app integradora autenticada (todas las rutas /api/v1/*).
RATE_LIMIT_APP_POR_MIN=3000
# Por (app, origen del usuario final) en verify, recovery, activate y resync. El origen es el
# client_ip que envía la app o, si no lo envía, la IP TCP de la app (todos sus usuarios comparten cupo).
RATE_LIMIT_ORIGEN_POR_MIN=60
# Ventana (minutos) en la que se cuentan, desde la tabla attempts, los fallos de usuarios sin
# enrolamiento activo para su bloqueo progresivo (persistente tras reinicios). 5 a 43200.
BLOQUEO_INEXISTENTES_VENTANA_MIN=1440

# Orígenes permitidos por CORS, separados por comas (esquema://host[:puerto]).
# La PWA (/app/) y la consola (/consola/) se sirven desde el mismo origen y no lo necesitan;
# el portal demo y el SDK llaman de servidor a servidor. Vacío = solo mismo origen.
CORS_ALLOWED_ORIGINS=

# Opcional: URL http(s) local de referencia horaria (por ejemplo, el servidor NTP/HTTP
# institucional) para medir el desfase del reloj cada 10 minutos (cabecera Date). Vacío = no se mide.
CLOCK_REFERENCE_URL=
